GCP_IP=203.0.113.12
GCP_SS_KEY=ZGVtb2djcHNzc2VydmVya2V5MDAwMDAwMA=
GCP_REALITY_PUBKEY=ZGVtb2djcHJlYWxpdHlwdWJrZXkwMDAwMDAwMDAwMA
GCP_REALITY_SHORT_ID=aa00000000000003
GCP_MTPROTO_SECRET=ee333333333333333333333333333333336578616d706c652e636f6d

# ── Scaleway London ───────────────────────────────────────────────
