# ⚠️  DEPRECATED — Migrating to sops+age encrypted secrets
# New approach: config/secrets/*.enc.yaml (encrypted, committed to git)
# See docs/guides/secrets-management.md for setup instructions
#
# This file is kept for backward compatibility with existing deploy scripts.
# For new setups, use sops+age instead.
#
# VPN V2 Deployment Variables
# Copy to vars.env and fill in your values

# Shared across all servers
UUID=<YOUR-UUID-HERE>
ADMIN_UUID=<YOUR-ADMIN-UUID>
SNI=www.google.com
DOMAIN=<YOUR-DOMAIN>

# Protocol passwords (shared across all servers)
SALAMANDER_PASSWORD=<YOUR-SALAMANDER-PASSWORD>
STLS_PASSWORD=<YOUR-SHADOWTLS-PASSWORD>

# SS2022 keys (per server, base64-encoded AES-128 keys)
SS2022_KEY_HELSINKI=<BASE64-KEY>
SS2022_KEY_ORACLE=<BASE64-KEY>
SS2022_KEY_GCP=<BASE64-KEY>
SS2022_KEY_SCALEWAY=<BASE64-KEY>
SS2022_USER_KEY=<BASE64-KEY>

# Server 1
S1_IP=<SERVER1_IP>
S1_TAG=server1
S1_PROVIDER=<PROVIDER>

# Server 2
S2_IP=<SERVER2_IP>
S2_TAG=server2
S2_PROVIDER=<PROVIDER>

# Server 3
S3_IP=<SERVER3_IP>
S3_TAG=server3
S3_PROVIDER=<PROVIDER>

# Server 4
S4_IP=<SERVER4_IP>
S4_TAG=server4
S4_PROVIDER=<PROVIDER>

# ── Iran Relay Server (v3 Hardened) ────────────────────────────
# Stealth domestic relay. See deploy-iran-relay.sh for full details.
#
# CRITICAL: IR_EXIT_CDN_HOST must be a CLEAN domain — NOT cdn.example.com!
# Register a fresh domain with NO VPN history, point it to CF Pages with
# the same worker. If burned, rotate without affecting other users.
#
IR_IP=<IRAN-SERVER-IP>
IR_SSH_USER=root
IR_SSH_PORT=22
IR_ANYTLS_PASS=<RANDOM-32-CHAR-PASSWORD>
IR_SS_KEY=<BASE64-16-BYTE-KEY>
# Clean exit domain (different from main VPN domains!)
IR_EXIT_CDN_HOST=<CLEAN-DOMAIN-HERE>
IR_EXIT_CDN_PATH=/xhttp
# Multi-CDN exit paths (optional but recommended)
IR_EXIT_VERCEL_HOST=<VERCEL-RELAY-HOST>
IR_EXIT_NETLIFY_HOST=<NETLIFY-RELAY-HOST>
# Cover site (popular Iranian site for AnyTLS fallback)
COVER_DOMAIN=divar.ir
SHADOWTLS_HANDSHAKE=cafebazaar.ir
# Bandwidth cap in kbit/s (default 5000 = 5 Mbps)
IR_BW_CAP_KBIT=5000

# ── Donate a Server ──────────────────────────────────────────────
# Want to help? The most impactful contribution is donating a server.
#
# Best case: An Iranian server (inside Iran) for relay/CDN purposes.
#   - Even a small VPS inside Iran dramatically improves latency
#   - Acts as a local entry point that forwards to our exit servers
#   - Iranian ISPs can't distinguish relay traffic from normal domestic traffic
#
# Any server helps:
#   - A VPS anywhere (even $3-5/mo) adds protocol diversity and redundancy
#   - More exit locations = harder to block all paths at once
#   - Providers with free tiers: Oracle Cloud, GCP, Azure
#
# To donate a server, open an issue or contact the admin with:
#   - Server IP, SSH access, provider, and location
#   - We handle all deployment and configuration
#
# DONATE_IP=<DONATED-SERVER-IP>
# DONATE_TAG=<DONATED-SERVER-TAG>
# DONATE_PROVIDER=<PROVIDER>
# DONATE_LOCATION=<CITY-COUNTRY>

# Cloudflare
CF_PAGES_PROJECT=<YOUR-CF-PAGES-PROJECT>
CF_PAGES_URL=<PROJECT>.pages.dev
CF_SUB_URL=https://<YOUR-SUB-DOMAIN>
# Note: workers.dev may not work. Use CF Pages custom domain instead.

# ── Future: Clean Relay Domain (Phase 4) ──────────────────────
# CLEAN_RELAY_DOMAIN=     # e.g. a .ir or fresh international domain for relay-only traffic
# BOOTSTRAP_DOMAIN=       # e.g. a separate domain for initial subscription bootstrapping
